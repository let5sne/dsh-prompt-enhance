{
  "name": "@let5sne/dsh-prompt-enhance",
  "version": "1.0.0",
  "description": "Adds a star button left of the model selector that rewrites the composer draft with the default model",
  "license": "MIT",
  "author": "let5sne",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "prompt",
    "composer",
    "input"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/let5sne/dsh-prompt-enhance.git"
  },
  "homepage": "https://github.com/let5sne/dsh-prompt-enhance#readme",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}